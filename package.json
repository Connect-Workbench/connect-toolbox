{
  "name": "connect-toolbox",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "connect-workbench",
  "license": "MIT",
  "icon": "resources/branding/connect-workbench-extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Connect-Workbench/connect-toolbox.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ssh",
    "mysql",
    "redis",
    "database",
    "terminal"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "connectToolbox.addConnection",
        "title": "%command.addConnection%",
        "icon": "$(add)"
      },
      {
        "command": "connectToolbox.editConnection",
        "title": "%command.editConnection%",
        "icon": "$(edit)"
      },
      {
        "command": "connectToolbox.removeConnection",
        "title": "%command.removeConnection%",
        "icon": "$(trash)"
      },
      {
        "command": "connectToolbox.connect",
        "title": "%command.connect%",
        "icon": "$(plug)"
      },
      {
        "command": "connectToolbox.disconnect",
        "title": "%command.disconnect%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "connectToolbox.openTerminal",
        "title": "%command.openTerminal%",
        "icon": "$(terminal)"
      },
      {
        "command": "connectToolbox.openQueryPanel",
        "title": "%command.openQueryPanel%",
        "icon": "$(notebook-execute)"
      },
      {
        "command": "connectToolbox.openTableData",
        "title": "%command.openTableData%",
        "icon": "$(table)"
      },
      {
        "command": "connectToolbox.showCreateTable",
        "title": "%command.showCreateTable%",
        "icon": "$(code)"
      },
      {
        "command": "connectToolbox.filterTree",
        "title": "%command.filterTree%",
        "icon": "$(filter)"
      },
      {
        "command": "connectToolbox.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "connectToolbox.editCell",
        "title": "%command.editCell%",
        "icon": "$(edit)"
      },
      {
        "command": "connectToolbox.openSettings",
        "title": "%command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "connectToolbox.generateMcpConfig",
        "title": "%command.generateMcpConfig%",
        "icon": "$(server)"
      },
      {
        "command": "connectToolbox.showMcpStatus",
        "title": "%command.showMcpStatus%",
        "icon": "$(pulse)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "connectToolbox",
          "title": "%viewContainer.connectToolbox%",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "connectToolbox": [
        {
          "id": "connectToolbox.connections",
          "name": "%view.connections%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "connectToolbox.addConnection",
          "when": "view == connectToolbox.connections",
          "group": "navigation@1"
        },
        {
          "command": "connectToolbox.refresh",
          "when": "view == connectToolbox.connections",
          "group": "navigation@2"
        },
        {
          "command": "connectToolbox.openSettings",
          "when": "view == connectToolbox.connections",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "connectToolbox.connect",
          "when": "view == connectToolbox.connections && viewItem =~ /^(mysql|redis|ssh)Connection$/",
          "group": "inline@1"
        },
        {
          "command": "connectToolbox.disconnect",
          "when": "view == connectToolbox.connections && viewItem =~ /ConnectionConnected$/",
          "group": "inline@2"
        },
        {
          "command": "connectToolbox.openTerminal",
          "when": "view == connectToolbox.connections && viewItem == sshConnectionConnected",
          "group": "inline@3"
        },
        {
          "command": "connectToolbox.openQueryPanel",
          "when": "view == connectToolbox.connections && viewItem == mysqlConnectionConnected",
          "group": "inline@3"
        },
        {
          "command": "connectToolbox.filterTree",
          "when": "view == connectToolbox.connections && viewItem =~ /^(mysqlConnectionConnected|mysqlDatabase)$/",
          "group": "inline@4"
        },
        {
          "command": "connectToolbox.openTableData",
          "when": "view == connectToolbox.connections && viewItem == mysqlTable",
          "group": "inline@1"
        },
        {
          "command": "connectToolbox.showCreateTable",
          "when": "view == connectToolbox.connections && viewItem == mysqlTable",
          "group": "1_view@1"
        },
        {
          "command": "connectToolbox.refresh",
          "when": "view == connectToolbox.connections && viewItem =~ /^(mysqlConnection|mysqlDatabase|mysqlTable)/",
          "group": "9_refresh@1"
        },
        {
          "command": "connectToolbox.editConnection",
          "when": "view == connectToolbox.connections && viewItem =~ /Connection/",
          "group": "1_modify@1"
        },
        {
          "command": "connectToolbox.removeConnection",
          "when": "view == connectToolbox.connections && viewItem =~ /Connection/",
          "group": "9_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "connectToolbox.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en-US"
          ],
          "enumDescriptions": [
            "%configuration.language.auto%",
            "%configuration.language.zhCN%",
            "%configuration.language.enUS%"
          ],
          "description": "%configuration.language.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && node esbuild.mjs && node esbuild.mjs --mcp",
    "build:webview": "cd webview && npm run build",
    "build:mcp": "node esbuild.mjs --mcp",
    "watch": "node esbuild.mjs --watch",
    "dev:webview": "cd webview && npm run dev",
    "typecheck": "tsc --noEmit",
    "typecheck:webview": "cd webview && npm run typecheck",
    "mcp": "node dist/mcp-server.js",
    "package": "npm run build && vsce package"
  },
  "dependencies": {
    "@connect_workbench/mcp-core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ag-grid-community": "^36.1.0",
    "mysql2": "^3.23.3",
    "pino": "^10.3.1",
    "sql-formatter": "^15.8.2",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0"
  }
}
